{
  "name": "comic-sub-desktop",
  "version": "0.1.0",
  "private": true,
  "author": "Comic Sub",
  "description": "Comic Sub embedded comic reader and translation app",
  "main": "main.cjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "build": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.comicsub.reader",
    "productName": "Comic Sub",
    "files": [
      "main.cjs",
      "preload.cjs",
      "reader-preload.cjs",
      "lib/**/*",
      "app/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "build/icon.icns"
    },
    "win": { "target": "nsis" }
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "engines": { "node": ">=22" }
}
