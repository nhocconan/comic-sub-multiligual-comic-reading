{
  "name": "manga-sub-desktop",
  "version": "0.2.4",
  "private": true,
  "author": "Manga Sub",
  "description": "Manga Sub embedded comic reader and translation app",
  "main": "main.cjs",
  "scripts": {
    "build:icons": "python3 scripts/build-icons.py",
    "build:ocr": "sh scripts/build-ocr-helper.sh",
    "dev": "npm run build:ocr && electron .",
    "start": "npm run build:ocr && electron .",
    "test": "node --test test/*.test.cjs",
    "build": "npm run build:icons && npm run build:ocr && electron-builder --dir",
    "dist": "npm run build:icons && npm run build:ocr && electron-builder",
    "dist:mac": "npm run build:icons && npm run build:ocr && electron-builder --mac --universal",
    "dist:win": "npm run build:icons && npm run build:ocr && electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "com.comicsub.reader",
    "productName": "Manga Sub",
    "files": [
      "main.cjs",
      "preload.cjs",
      "reader-preload.cjs",
      "lib/**/*",
      "app/**/*",
      "build/icon.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "build/icon.icns",
      "artifactName": "Manga-Sub-mac-${arch}.${ext}",
      "target": [
        { "target": "dmg", "arch": ["universal"] },
        { "target": "zip", "arch": ["universal"] }
      ],
      "extraResources": [
        {
          "from": "bin",
          "to": "bin",
          "filter": ["manga-sub-ocr", "manga-sub-credentials", "manga-sub-translation"]
        }
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "Manga-Sub-win-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "engines": { "node": ">=22" }
}
