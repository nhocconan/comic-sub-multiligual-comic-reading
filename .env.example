# auto: native Koharu on Apple Silicon, Docker Compose everywhere else.
# native: force the macOS app and Metal acceleration.
# docker: force the pinned container (CPU/emulated on Apple Silicon).
RUNTIME_MODE=auto

# start.command can install the official Homebrew cask when native mode is
# selected and Koharu is missing.
INSTALL_KOHARU_IF_MISSING=true

# Optional explicit executable path for a manually downloaded native build.
KOHARU_NATIVE_BINARY=

# Optional. Keys are sent once to Koharu's loopback config API and persisted in
# its credential store. They are never passed into the browser extension.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=
